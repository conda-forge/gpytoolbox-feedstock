From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: conda-forge staged-recipes <conda-forge@users.noreply.github.com>
Date: Mon, 11 May 2026 08:45:00 -0700
Subject: [PATCH] Use conda-forge build dependencies

Avoid fetching WebGPU-distribution's prebuilt wgpu-native binaries during the
build. The recipe provides matching C/C++ WebGPU headers as explicit hashed
sources because the current conda-forge WebGPU C headers are not
source-compatible with this generated wrapper, and links the extension against
conda-forge's wgpu-native package. Also use conda-forge pybind11 and nanoflann
instead of adding those projects as source copies, and build the pinned CDT
commit from a hashed recipe source instead of fetching it.
---
 CMakeLists.txt     |  6 ++---
 cmake/CDT.cmake    |  9 +-------
 cmake/webgpu.cmake | 55 ++++++++++++++++++++++++++++++++++++++++------
 3 files changed, 52 insertions(+), 18 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0376216..4f3f418 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,7 +50,7 @@ add_library(PoissonRecon INTERFACE)
 target_include_directories(PoissonRecon INTERFACE "${CMAKE_BINARY_DIR}/_deps/poissonrecon-src/Src/")
 
 # Include nanoflann
-include(nanoflann)
+find_package(nanoflann CONFIG REQUIRED)
 
 # Include CDT
 include(CDT)
@@ -66,7 +66,7 @@ else()
 endif()
 
 # List of all libraries to link
-set(LIBRARIES_TO_LINK igl::core nanoflann CDT::CDT PoissonRecon ${GL_LIBS})
+set(LIBRARIES_TO_LINK igl::core nanoflann::nanoflann CDT::CDT PoissonRecon ${GL_LIBS})
 if(LIBIGL_EMBREE)
 	list(APPEND LIBRARIES_TO_LINK igl::embree)
 endif()
@@ -160,7 +160,7 @@ endif()
 set(LIBRARIES_TO_LINK cpytoolbox ${LIBRARIES_TO_LINK})
 
 # Otman's python bindings using pybind11
-add_subdirectory(./ext/pybind11/)
+find_package(pybind11 CONFIG REQUIRED)
 pybind11_add_module(gpytoolbox_bindings
     "${CMAKE_CURRENT_SOURCE_DIR}/src/cpp/gpytoolbox_bindings_core.cpp"
 	"${CMAKE_CURRENT_SOURCE_DIR}/src/cpp/binding_read_obj.cpp"
diff --git a/cmake/CDT.cmake b/cmake/CDT.cmake
index 5010a88..33eb708 100644
--- a/cmake/CDT.cmake
+++ b/cmake/CDT.cmake
@@ -2,11 +2,4 @@ if(TARGET CDT::CDT)
     return()
 endif()
 
-include(FetchContent)
-FetchContent_Declare(
-    CDT
-    GIT_REPOSITORY https://github.com/artem-ogre/CDT.git
-    GIT_TAG 3765e08ec4bbef0c6b721204d7c0e45d279084e9
-    SOURCE_SUBDIR CDT
-)
-FetchContent_MakeAvailable(CDT)
+add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/ext/CDT/CDT" "${CMAKE_BINARY_DIR}/_deps/cdt-build")
diff --git a/cmake/webgpu.cmake b/cmake/webgpu.cmake
index 676e792..6d5f87b 100644
--- a/cmake/webgpu.cmake
+++ b/cmake/webgpu.cmake
@@ -2,10 +2,51 @@ if(TARGET webgpu)
     return()
 endif()
 
-include(FetchContent)
-FetchContent_Declare(
-    webgpu
-    GIT_REPOSITORY https://github.com/eliemichel/WebGPU-distribution.git
-    GIT_TAG 9dd47f8515dfd7112b750da07e719460a88bf2e8
-)
-FetchContent_MakeAvailable(webgpu)
\ No newline at end of file
+set(WGPU_PREFIX "$ENV{PREFIX}")
+set(WGPU_HEADERS "${CMAKE_CURRENT_SOURCE_DIR}/ext/webgpu-distribution-headers")
+
+add_library(webgpu SHARED IMPORTED GLOBAL)
+target_compile_definitions(webgpu INTERFACE WEBGPU_BACKEND_WGPU)
+
+if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
+    find_file(
+        WGPU_RUNTIME_LIB
+        NAMES wgpu_native.dll
+        PATHS "${WGPU_PREFIX}/Library/bin"
+        NO_DEFAULT_PATH
+    )
+    find_library(
+        WGPU_IMPORT_LIB
+        NAMES wgpu_native
+        PATHS "${WGPU_PREFIX}/Library/lib"
+        NO_DEFAULT_PATH
+    )
+    set_target_properties(
+        webgpu
+        PROPERTIES
+            IMPORTED_LOCATION "${WGPU_RUNTIME_LIB}"
+            IMPORTED_IMPLIB "${WGPU_IMPORT_LIB}"
+            INTERFACE_INCLUDE_DIRECTORIES "${WGPU_HEADERS}"
+            INTERFACE_LINK_LIBRARIES "ws2_32;userenv;bcrypt;ntdll;d3dcompiler"
+    )
+else()
+    find_library(
+        WGPU_RUNTIME_LIB
+        NAMES wgpu_native libwgpu_native
+        PATHS "${WGPU_PREFIX}/lib"
+        NO_DEFAULT_PATH
+    )
+    set_target_properties(
+        webgpu
+        PROPERTIES
+            IMPORTED_LOCATION "${WGPU_RUNTIME_LIB}"
+            INTERFACE_INCLUDE_DIRECTORIES "${WGPU_HEADERS}"
+    )
+endif()
+
+if(NOT WGPU_RUNTIME_LIB)
+    message(FATAL_ERROR "Could not find conda-forge wgpu-native library")
+endif()
+
+function(target_copy_webgpu_binaries Target)
+endfunction()
